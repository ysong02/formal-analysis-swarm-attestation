// Security properties for SALSA: Standards-based Authentication and Lightweight Swarm Attestation for IoT Devices

// ********************************************************************
// ************** Sanity Check ****************************************
// ********************************************************************

// Sanity checks for the executability of the protocol
// We check for each method and each role.

#ifdef SanityChecks & not KEM

lemma executableR_method_1[output=[proverif]]: // sanity check
    exists-trace
    "Ex cid e1 e2 pkI pkR k3 k4 ko #i. AcceptR(cid,method_one,pkI,pkR,k3,k4,ko,e1,e2)@i"

lemma executableR_method_2[output=[proverif]]: // sanity check
    exists-trace
    "Ex cid e1 e2 pkI pkR k3 k4 ko #i. AcceptR(cid,method_two,pkI,pkR,k3,k4,ko,e1,e2)@i"

lemma executableR_method_3[output=[proverif]]: // sanity check
    exists-trace
    "Ex cid e1 e2 pkI pkR k3 k4 ko #i. AcceptR(cid,method_three,pkI,pkR,k3,k4,ko,e1,e2)@i"

lemma executableI_method_1[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i. AcceptI(cid,method_one,pkI,pkR,k3,k4,ko,e1,e2)@i"

lemma executableI_method_2[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i. AcceptI(cid,method_two,pkI,pkR,k3,k4,ko,e1,e2)@i"

lemma executableI_method_3[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i. AcceptI(cid,method_three,pkI,pkR,k3,k4,ko,e1,e2)@i"

#endif

#ifdef SanityChecks

lemma executableR_method_0[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 k4 ko #i #j #l. AcceptR(cid,method_zero,pkI,pkR,k3,k4,ko,e1,e2)@i & Honest(pkI)@j & Honest(pkR)@l"

lemma executableI_method_0[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i #j #l. AcceptI(cid,method_zero,pkI,pkR,k3,k4,ko,e1,e2)@i & Honest(pkI)@j & Honest(pkR)@l"

#endif


// ******************************************************************
// ************** Attestation ***************************************
// ******************************************************************
 
// result is true
// Evidence sending uniqueness -> One request sent by Initiator cannot generate two different evidences
lemma EvidenceUniqueness1:
  "All cidI pkI pkR th3 ab pkI1 pkR1 sig1 ak1 pkI2 pkR2 sig2 ak2 downlink_slot #i #j #k.
    SentMsg3_bg(cidI, pkI, pkR, th3, downlink_slot)@k
    &
    EvidenceGenerated_bg(pkI1, pkR1, sig1, ak1, ab, th3, downlink_slot)@i
    &
    EvidenceGenerated_bg(pkI2, pkR2, sig2, ak2, ab, th3, downlink_slot)@j
  ==>
    (#i = #j) & (pkI1 = pkI2) & (pkR1 = pkR2) & (sig1 = sig2) & (ak1 = ak2) & (pkI1 = pkI) & (pkR1 = pkR)
  "

// result is true
// Evidence uniqueness -> One initiator cannot accept two different evidences generated. 
lemma EvidenceUniqueness2:
  "All cidI pkI pkR ab pkI1 pkR1 sig1 ak1 th31 pkI2 pkR2 sig2 ak2 th32 downlink_slot #i #j #k.
    ReceivedMsg4_bg(cidI, pkI, pkR, ab)@k
    &
    EvidenceGenerated_bg(pkI1, pkR1, sig1, ak1, ab, th31, downlink_slot)@i
    &
    EvidenceGenerated_bg(pkI2, pkR2, sig2, ak2, ab, th32, downlink_slot)@j
  ==>
    (#i = #j) & (pkI1 = pkI2) & (pkR1 = pkR2) & (sig1 = sig2) & (ak1 = ak2) & (th31 = th32) & (pkI1 = pkI) & (pkR1 = pkR)
  "


// result is true
// Attestation Evidence integrity -> the evidence the Verifier checks was not
// modified/tampered with after the Responder generated it.
lemma AttestationEvidenceIntegrity:
  "All pkI pkR sig ab ak #i.
    VerifiedSignature_bg(pkI, pkR, sig, ab, pk(ak))@i
  ==>
  (Ex th3 downlink_slot #t.
    EvidenceGenerated_bg(pkI, pkR, sig, ak, ab, th3, downlink_slot)@t 
    & t < i )
  |
  (Ex #t. LeakAttKey(ak)@t)
  |
  (Ex #t.  Compromise(pkI)@t)
  |
  (Ex #t.  Compromise(pkR)@t)
  "

// result is true
// Agreement on parameters of attestation and authentication -> if the Relying Party
// finishes trusting a Verifier decision, the Responder must have finished the matching
// EDHOC session, unless a long-term key was compromised.
lemma AgreementParameters:
  "All cidI method pkI pkR gxy x gx gy ab meas pkv th3 uplink_slot ak #i #j #k.
    Finish_I(cidI, method, pkI, pkR, gxy, x, gx, gy, ab, id_att(hash(meas), pk(ak)), pkv, th3, uplink_slot)@i
   ==>
   (Ex cidR y sig meashash dl #t. Finish_R(cidR, method, pkI, pkR, gxy, y, gx, gy, sig, meashash, id_att(hash(meas), pk(ak)), pk(ak), ab, th3, dl)@t & t < i )
    |
    (Ex #t. Compromise(pkR)@t & t < i)
    |
    (Ex #t. Compromise(pkI)@t & t < i)
    |
    (Ex #t. LeakAttKey(ak)@t & t < i)
    |
    (Ex #t. Compromise(pkv)@t & t < i)
    "

// result is true
// Channel binding property for Evidence, as a three-event chain: the Verifier only
// accepts if the Relying Party genuinely forwarded evidence that the Responder genuinely
// sent, all tied together by the same attestation_binder and the same th3

lemma ChannelBindingEvidence:
"All pkI pkR sig ab ak meas uplink_slot pkv #j.
    AttestationAccepted_bg(pkI, pkR, sig, ab, pk(ak), id_att(hash(meas), pk(ak)), uplink_slot, pkv)@j
  ==>
    (Ex cidI cidR gxy gx gy th3 dl #i #h.
        ForwardedToVerifier_bg(cidI, pkI, pkR, uplink_slot, ab, th3)@i
        & SentByR(cidR, pkI, pkR, sig, gxy, gx, gy, th3, ak, pk(ak), id_att(hash(meas), pk(ak)), ab, dl)@h
        & h < i
        & i < j
    )
    |
    (Ex #t. LeakAttKey(ak)@t)
"

// result is true
// Result integrity -> the decision the Relying Party trusts was genuinely
// rendered by the Verifier for this exact evidence, unless the Verifier's own long-term
// key was compromised.
lemma ResultIntegrity:
  "All cidI method pkI pkR gyx x gx gy ab idatt pkv th3i uplink_sloti #i #j #k.
    Finish_I(cidI, method, pkI, pkR, gyx, x, gx, gy, ab, idatt, pkv, th3i, uplink_sloti)@i
    &
    Honest(pkI)@j
    &
    Honest(pkR)@k
  ==>
  (Ex sig pkak uplink_slot #t.
    AttestationAccepted_bg(pkI, pkR, sig, ab, pkak, idatt, uplink_slot, pkv)@t
    & t < i)
  |
  (Ex #t. Compromise(pkv)@t)
  "

// Result uniqueness -> the Verifier cannot generate two different results for the same
// request: any two ResultGenerated events sharing the same uplink_slot must agree on
// every other field too.

// checked: with #i=#j, it is cannot be proven
// remove the #i=#j, it is true
lemma ResultUniqueness:
  "All pkI1 sig1 ab1 pkI2 sig2 ab2 uplink_slot #i #j.
    ResultGenerated(pkI1, sig1, ab1, uplink_slot)@i
    &
    ResultGenerated(pkI2, sig2, ab2, uplink_slot)@j
  ==>
  (pkI1 = pkI2) & (sig1 = sig2) & (ab1 = ab2)
  "

