
// Security properties for SALSA: Standards-based Authentication and Lightweight Swarm Attestation for IoT Devices

// ********************************************************************
// ************** Sanity Check ****************************************
// ********************************************************************

// Sanity checks for the executability of the protocol
// We check for each method and each role.

#ifdef SanityChecks & not KEM

lemma executableR_method_1[output=[proverif]]: // sanity check
    exists-trace
    "Ex cid e1 e2 pkI pkR k3 ko #i. AcceptR(cid,method_one,pkI,pkR,k3,ko,e1,e2)@i"

lemma executableR_method_2[output=[proverif]]: // sanity check
    exists-trace
    "Ex cid e1 e2 pkI pkR k3 ko #i. AcceptR(cid,method_two,pkI,pkR,k3,ko,e1,e2)@i"

lemma executableR_method_3[output=[proverif]]: // sanity check
    exists-trace
    "Ex cid e1 e2 pkI pkR k3 ko #i. AcceptR(cid,method_three,pkI,pkR,k3,ko,e1,e2)@i"

lemma executableI_method_1[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i. AcceptI(cid,method_one,pkI,pkR,k3,k4,ko,e1,e2)@i"

lemma executableI_method_2[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i. AcceptI(cid,method_two,pkI,pkR,k3,k4,ko,e1,e2)@i"

lemma executableI_method_3[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i. AcceptI(cid,method_three,pkI,pkR,k3,k4,ko,e1,e2)@i"

#endif

#ifdef SanityChecks

lemma executableR_method_0[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko #i #j #l. AcceptR(cid,method_zero,pkI,pkR,k3,ko,e1,e2)@i & Honest(pkI)@j & Honest(pkR)@l"

lemma executableI_method_0[output=[proverif]]: // sanity check
  exists-trace
  "Ex cid e1 e2 pkI pkR k3 ko k4 #i #j #l. AcceptI(cid,method_zero,pkI,pkR,k3,k4,ko,e1,e2)@i & Honest(pkI)@j & Honest(pkR)@l"
  
#endif


// ******************************************************************
// ************** Attestation ***************************************
// ******************************************************************

// Evidence freshness -> for a given session (same TH_3), evidence is generated by the
// Responder strictly between the Relying Party's own send-message-3 and receive-message-4
// events.
lemma AttestationEvidenceFreshness:
  "All cid pkI pkR th3 sig gxy gx gy ak pkak idatt ab #i #j #k.
    SentMsg3_bg(cid, pkI, pkR, th3)@i
    &
    SentByR(cid, pkI, pkR, sig, gxy, gx, gy, th3, ak, pkak, idatt, ab)@j
    &
    ReceivedMsg4_bg(cid, pkI, pkR, ab)@k
  ==>
  (#i < #j)
  &
  (#j < #k)
  "

// Attestation Evidence integrity -> the evidence the Verifier checks was not
// modified/tampered with after the Responder generated it.
lemma AttestationEvidenceIntegrity:
  "All pkI pkR sig ab pkak #i #j #k.
    VerifiedSignature_bg(pkI, pkR, sig, ab, pkak)@i
    &
    Honest(pkI)@j
    &
    Honest(pkR)@k
  ==>
  (Ex cidR ak y gxy #t.
    EvidenceGenerated_bg(cidR, pkI, pkR, sig, ak, y, gxy, ab)@t
    & t < i)
  |
  (Ex ak #t. LeakAttKey(ak)@t)
  |
  (Ex #t.  Compromise(pkI)@t)
  |
  (Ex #t.  Compromise(pkR)@t)
  "

// Agreement on parameters of attestation and authentication -> if the Relying Party
// finishes trusting a Verifier decision, the Responder must have finished the matching
// EDHOC session, unless a long-term key was compromised.
lemma AgreementParamaters:
  "All cidI method pkI pkR gxy x gx gy ab idatt pkv #i #j #k.
     Finish_I(cidI, method, pkI, pkR, gxy, x, gx, gy, ab, idatt, pkv)@i
     &
     Honest(pkI)@j
     &
     Honest(pkR)@k
   ==>
   (Ex cidR y sig meas pkak #t. Finish_R(cidR, method, pkI, pkR, gxy, y, gx, gy, sig, meas, idatt, pkak, ab)@t & t < i )
    |
    (Ex #t. Compromise(pkR)@t & t < i)
    |
    (Ex #t. Compromise(pkI)@t & t < i)
    |
    (Ex ak #t. LeakAttKey(ak)@t & t < i)
    |
    (Ex #t. Compromise(pkv)@t & t < i)
    "

// Channel binding property for Evidence, as a three-event chain: the Verifier only
// accepts if the Relying Party genuinely forwarded evidence that the Responder genuinely
// sent, all tied together by the same attestation_binder and the same th3

lemma ChannelBindingEvidence:
"All pkI pkR sig ab pkak idatt offset pkv #j.
    AttestationAccepted_bg(pkI, pkR, sig, ab, pkak, idatt, offset, pkv)@j
  ==>
    (Ex cidI cidR gxy gx gy th3 ak #i #h.
        ForwardedToVerifier_bg(cidI, pkI, pkR, offset, ab, th3)@i
        & SentByR(cidR, pkI, pkR, sig, gxy, gx, gy, th3, ak, pkak, idatt, ab)@h
        & h < i
        & i < j
    )
    |
    (Ex ak #t. LeakAttKey(ak)@t)
    |
    (Ex #t. Compromise(pkI)@t)
    |
    (Ex #t. Compromise(pkv)@t)
"

// Result integrity -> the decision the Relying Party trusts was genuinely
// rendered by the Verifier for this exact evidence, unless the Verifier's own long-term
// key was compromised.
lemma ResultIntegrity:
  "All cidI method pkI pkR gyx x gx gy ab idatt pkv #i #j #k.
    Finish_I(cidI, method, pkI, pkR, gyx, x, gx, gy, ab, idatt, pkv)@i
    &
    Honest(pkI)@j
    &
    Honest(pkR)@k
  ==>
  (Ex sig pkak offset #t.
    AttestationAccepted_bg(pkI, pkR, sig, ab, pkak, idatt, offset, pkv)@t
    & t < i)
  |
  (Ex #t. Compromise(pkv)@t)
  "

// Result freshness -> for a given session, whenever the Relying
// Party finishes consuming the attestation result, there must have existed a report-forward and an
// accept, correctly ordered before it.
lemma ResultFreshness:
  "All cidI method pkI pkR gyx x gx gy ab idatt pkv #k.
    Finish_I(cidI, method, pkI, pkR, gyx, x, gx, gy, ab, idatt, pkv)@k
  ==>
  (Ex offset th3 sig pkak #i #j.
    ForwardedToVerifier_bg(cidI, pkI, pkR, offset, ab, th3)@i
    & AttestationAccepted_bg(pkI, pkR, sig, ab, pkak, idatt, offset, pkv)@j
    & i < j
    & j < k
  )
  |
  (Ex ak #t. LeakAttKey(ak)@t)
  |
  (Ex #t. Compromise(pkI)@t)
  |
  (Ex #t. Compromise(pkR)@t)
  |
  (Ex #t. Compromise(pkv)@t)
  "


